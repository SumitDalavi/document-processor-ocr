# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: document-processor-ocr
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-process Tesseract OCR and local filesystem storage.
#
# TIER 2 / TIER 3: PRODUCTION MULTI-CLOUD OCR & PERSISTENCE
# - Provide PostgreSQL, Redis, and Cloud Storage credentials.

DATABASE_URL=postgresql://user:pass@localhost:5432/ocr_db
REDIS_URL=redis://localhost:6379
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
OPENAI_API_KEY=
PORT=8000
